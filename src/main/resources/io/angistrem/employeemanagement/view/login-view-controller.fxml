<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox fx:id="loginRoot" prefHeight="768.0" prefWidth="1024.0"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.angistrem.employeemanagement.controller.LoginController">
    <children>
        <AnchorPane styleClass="leftAnchorPane" stylesheets="@../styles/loginDesign.css" HBox.hgrow="ALWAYS">
            <children>
                <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <children>
                        <VBox alignment="CENTER" spacing="20.0">
                            <children>
                                <FontIcon fill="WHITE" iconLiteral="mdi2a-account-multiple" iconSize="120" />
                                <Label text="Employee Management">
                                    <font>
                                        <Font name="Cambria Math" size="20.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </children>
        </AnchorPane>

        <AnchorPane styleClass="rightAnchorPane" stylesheets="@../styles/loginDesign.css" HBox.hgrow="ALWAYS">
            <children>
                <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <children>
                        <VBox alignment="CENTER" maxWidth="400.0" spacing="20.0">
                            <children>
                                <Label text="Авторизация" textAlignment="CENTER">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>

                                <TextField fx:id="loginField"
                                           maxWidth="1.7976931348623157E308"
                                           promptText="Логин"
                                           styleClass="textfield login-textfield"
                                           stylesheets="@../styles/loginDesign.css" />

                                <StackPane alignment="CENTER_RIGHT" maxWidth="1.7976931348623157E308">
                                    <children>
                                        <PasswordField fx:id="passwordField"
                                                       maxWidth="1.7976931348623157E308"
                                                       promptText="Пароль"
                                                       styleClass="textfield login-textfield"
                                                       stylesheets="@../styles/loginDesign.css" />
                                        <TextField fx:id="passwordVisibleField"
                                                   maxWidth="1.7976931348623157E308"
                                                   promptText="Пароль"
                                                   styleClass="textfield login-textfield"
                                                   stylesheets="@../styles/loginDesign.css"
                                                   visible="false"
                                                   managed="false" />
                                        <Button fx:id="togglePasswordButton"
                                                mnemonicParsing="false"
                                                onAction="#handleTogglePasswordVisibility"
                                                styleClass="eyeStyle"
                                                stylesheets="@../styles/loginDesign.css">
                                            <graphic>
                                                <FontIcon fx:id="passwordEyeIcon"
                                                          boundsType="VISUAL"
                                                          iconLiteral="mdi2e-eye-outline"
                                                          iconSize="20"
                                                          strokeType="OUTSIDE"
                                                          strokeWidth="0.0" />
                                            </graphic>
                                        </Button>
                                    </children>
                                </StackPane>

                                <Button fx:id="login"
                                        maxWidth="1.7976931348623157E308"
                                        mnemonicParsing="false"
                                        onAction="#handleLogin"
                                        styleClass="login"
                                        stylesheets="@../styles/loginDesign.css"
                                        text="Войти">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                    <graphic>
                                        <FontIcon iconLiteral="mdi2a-account-key-outline" iconSize="32" />
                                    </graphic>
                                </Button>

                                <Button text="Регистрация"
                                        maxWidth="1.7976931348623157E308"
                                        mnemonicParsing="false"
                                        onAction="#handleRegister"
                                        styleClass="login"
                                        stylesheets="@../styles/loginDesign.css">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                    <graphic>
                                        <FontIcon iconLiteral="mdi2a-account-multiple-plus" iconSize="32" />
                                    </graphic>
                                </Button>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </children>
        </AnchorPane>
    </children>
</HBox>
